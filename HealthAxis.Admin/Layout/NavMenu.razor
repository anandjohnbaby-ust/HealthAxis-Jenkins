@using HealthAxis.Admin.Authentication
@inject IJSRuntime JSRuntime
@inject CustomAuthenticationStateProvider AuthProvider
@inject NavigationManager NavigationManager

<AuthorizeView>
    <Authorized>
        <div class="top-row ps-3 navbar navbar-dark">

            <div class="container-fluid">

                <a class="navbar-brand" href="#" @onclick:preventDefault="true" @onclick="ReloadPage">
                    <span class="brand-mark">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z" />
                        </svg>
                    </span>
                    HealthAxis Admin
                </a>

                <button class="navbar-toggler"
                        title="Navigation menu"
                        @onclick="ToggleNavMenu">

                    <span class="navbar-toggler-icon"></span>

                </button>

            </div>

        </div>


        <div class="@NavMenuCssClass nav-scrollable"
             @onclick="ToggleNavMenu">

            <nav class="nav flex-column sidebar-nav">

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.All">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <rect x="3" y="3" width="7" height="9" rx="1.5" />
                            <rect x="14" y="3" width="7" height="5" rx="1.5" />
                            <rect x="14" y="12" width="7" height="9" rx="1.5" />
                            <rect x="3" y="16" width="7" height="5" rx="1.5" />
                        </svg>
                        Dashboard
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/doctors">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z" />
                        </svg>
                        Doctors
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/patients">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                        Patients
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/reports">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                            <path d="M14 2v6h6" />
                            <path d="M9 13h6M9 17h6" />
                        </svg>
                        Reports
                    </NavLink>
                </div>

                <div class="nav-divider"></div>

                <div class="nav-item px-3 logout-container">
                    <a class="nav-link logout-link" href="#" @onclick:preventDefault="true" @onclick="Logout">
                        <svg class="nav-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                            <path d="M16 17l5-5-5-5" />
                            <path d="M21 12H9" />
                        </svg>
                        Logout
                    </a>
                </div>

            </nav>

        </div>
    </Authorized>

    <NotAuthorized>
        <!-- No navbar or brand for anonymous users -->
    </NotAuthorized>

</AuthorizeView>

<style>

    :root {
        --hx-primary: #155E91;
        --hx-primary-dark: #0E3A5C;
        --hx-primary-light: #EAF2F8;
        --hx-accent: #E2A33B;
    }

    .top-row {
        background: var(--hx-primary-dark);
        height: 3.75rem;
    }

    .navbar-brand {
        display: flex;
        align-items: center;
        gap: .55rem;
        font-weight: 700;
        color: #fff;
        letter-spacing: .01rem;
    }

    .brand-mark {
        width: 30px;
        height: 30px;
        border-radius: 8px;
        background: rgba(255,255,255,.12);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
    }

    .nav-scrollable {
        background: var(--hx-primary);
        height: calc(100vh - 3.75rem);
    }

    .nav-item { margin: 2px 0; }

    .nav-item .nav-link,
    .logout-link {
        display: flex;
        align-items: center;
        gap: .65rem;
        color: rgba(255,255,255,.78);
        font-weight: 500;
        font-size: .95rem;
        padding: .65rem .85rem;
        border-radius: 10px;
        transition: background .15s ease, color .15s ease;
    }

    .nav-icon {
        flex-shrink: 0;
        opacity: .9;
    }

    .nav-item .nav-link:hover,
    .logout-link:hover {
        background: rgba(255,255,255,.10);
        color: #fff;
    }

    .nav-item .nav-link.active {
        background: #fff;
        color: var(--hx-primary);
        font-weight: 700;
    }

    .nav-item .nav-link.active .nav-icon {
        color: var(--hx-accent);
        opacity: 1;
    }

    .nav-divider {
        height: 1px;
        background: rgba(255,255,255,.15);
        margin: .6rem 1rem;
    }

    .logout-link { color: rgba(255,255,255,.7); }
    .logout-link:hover { color: #fff; }

    .sidebar-nav {
    display: flex;
    flex-direction: column;
    height: 100%;
    }

    .logout-container {
        margin-top: auto;
        padding-bottom: 1rem;
    }
</style>

@code
{
    private bool collapseNavMenu = true;

    private string? NavMenuCssClass =>
        collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task Logout()
    {
        // Clear token from localStorage and notify auth provider
        await JSRuntime.InvokeVoidAsync("localStorage.removeItem", "token");
        AuthProvider.NotifyUserLoggedOut();

        // Navigate without forcing a full reload so app state updates via auth provider
        NavigationManager.NavigateTo("/login");
    }

    private void ReloadPage()
    {
        // Force a full reload of the current page without navigating to root
        NavigationManager.NavigateTo(NavigationManager.Uri, forceLoad: true);
    }
}
