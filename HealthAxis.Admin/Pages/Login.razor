@page "/login"

@using HealthAxis.Admin.Authentication

@inject HttpClient Http
@inject IJSRuntime Js
@inject NavigationManager Navigation
@inject CustomAuthenticationStateProvider AuthStateProvider

@layout MinimalLayout

<div class="d-flex justify-content-center align-items-center vh-100">
    <div class="card p-4" style="min-width:320px;max-width:420px;width:100%;">
        <h3 class="text-primary text-center mb-3">Admin Login</h3>

        <EditForm Model="loginRequest" OnValidSubmit="HandleLogin">

        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">

            <label class="form-label">Email</label>

            <InputText class="form-control"
                       @bind-Value="loginRequest.Email" />

            <ValidationMessage For="@(() => loginRequest.Email)" />

        </div>

        <div class="mb-3">

            <label class="form-label">Password</label>

            <InputText class="form-control"
                       type="password"
                       @bind-Value="loginRequest.Password" />

            <ValidationMessage For="@(() => loginRequest.Password)" />

        </div>

        <button class="btn btn-primary w-100">
            Login
        </button>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3">
                @errorMessage
            </div>
        }

        </EditForm>
    </div>
</div>

@code
{
    private LoginDto loginRequest = new();

    private string? errorMessage;

    private async Task HandleLogin()
    {
        errorMessage = null;
        try
        {
            var response = await Http.PostAsJsonAsync("api/auth/login", loginRequest);

            if (response.IsSuccessStatusCode)
            {
                var authResponse =
                    await response.Content.ReadFromJsonAsync<AuthResponse>();

                if (authResponse is not null)
                {
                    await Js.InvokeVoidAsync(
                        "localStorage.setItem",
                        "token",
                        authResponse.AccessToken);

                    AuthStateProvider.NotifyUserLoggedIn(authResponse.AccessToken);

                    Navigation.NavigateTo("/dashboard", true);
                    return;
                }
            }

            // If we reach here, show a generic error
            errorMessage = "Invalid email or password.";
        }
        catch (System.Net.Http.HttpRequestException)
        {
            // API unreachable (e.g. backend not running)
            errorMessage = "Unable to reach API. Please ensure the backend is running and try again.";
        }
        catch (Exception)
        {
            errorMessage = "An unexpected error occurred. Please try again.";
        }
    }
}