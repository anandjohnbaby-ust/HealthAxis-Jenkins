@page "/doctors"
@attribute [Authorize]

@using HealthAxis.Admin.Services
@using HealthAxis.Shared.Common
@using HealthAxis.Shared.DTOs.DoctorDtos
@using HealthAxis.Shared.DTOs.AdminDtos
@using HealthAxis.Shared.Enums

@inject DoctorService DoctorService

<PageTitle>Doctors</PageTitle>

<div class="page-header mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="header-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z" />
            </svg>
        </div>
        <div>
            <h2 class="fw-bold mb-1">Doctors</h2>
            <p class="text-muted mb-0">View, add and manage doctors on the platform.</p>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4">

    <div class="card-header bg-white py-3">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3">

            <div class="d-flex flex-wrap gap-3">

                <div style="width:230px">
                    <InputSelect class="form-select"
                                 @bind-Value="selectedSpecialisation"
                                 @bind-Value:after="FilterDoctors">
                        <option value="">All specialisations</option>
                        @foreach (var spec in Enum.GetValues<Specialisation>())
                        {
                            <option value="@spec">@spec</option>
                        }
                    </InputSelect>
                </div>

                <div class="search-wrap" style="width:280px">
                    <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="11" cy="11" r="8" />
                        <path d="m21 21-4.3-4.3" />
                    </svg>
                    <input class="form-control"
                           placeholder="Search by ID or name..."
                           value="@searchText"
                           @oninput="SearchDoctors" />
                </div>

            </div>

            <button class="btn btn-add" @onclick="ShowAddForm">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                    <path d="M12 5v14M5 12h14" />
                </svg>
                Add doctor
            </button>

        </div>
    </div>

    @if (doctors == null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status"></div>
            <div class="mt-3 text-muted">Loading doctors...</div>
        </div>
    }
    else if (!doctors.Any())
    {
        <div class="text-center py-5">
            <div class="empty-icon mb-2">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <circle cx="11" cy="11" r="8" />
                    <path d="m21 21-4.3-4.3" />
                </svg>
            </div>
            <h5>No doctors found</h5>
            <p class="text-muted">Try a different name, ID or specialisation.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Specialisation</th>
                        <th>Experience</th>
                        <th>Fee</th>
                        <th>Status</th>
                        <th width="100">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var doctor in doctors)
                    {
                        <tr>

                            <td class="text-muted">#@doctor.DoctorId</td>

                            <td class="fw-semibold">@doctor.FullName</td>

                            <td>
                                <span class="badge badge-spec">@doctor.Specialisation</span>
                            </td>

                            <td class="text-muted">@doctor.YearsOfExperience yrs</td>

                            <td class="fw-semibold">@($"Rs. {doctor.ConsultationFee:N2}")</td>

                            <td>
                                <div class="status-switch"
                                     role="switch"
                                     aria-checked="@(doctor.IsActive.ToString().ToLower())"
                                     tabindex="0"
                                     @onclick="() => ToggleActive(doctor)"
                                     @onkeydown="@(async (KeyboardEventArgs e) => { if (e.Key == "Enter" || e.Key == " ") await ToggleActive(doctor); })"
                                     title="Toggle active status">

                                    <div class="switch-track @(doctor.IsActive ? "on" : "")">
                                        <div class="switch-knob"></div>
                                    </div>

                                    <span class="status-label @(doctor.IsActive ? "text-active" : "text-inactive")">
                                        @(doctor.IsActive ? "Active" : "Inactive")
                                    </span>

                                </div>
                            </td>

                            <td>
                                <button class="btn btn-sm btn-edit" @onclick="() => ShowEditForm(doctor)">Edit</button>
                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">

    <div class="text-muted small">
        Showing
        <strong>@(doctors.Count == 0 ? 0 : ((currentPage - 1) * pageSize) + 1)</strong>
        -
        <strong>@(((currentPage - 1) * pageSize) + doctors.Count)</strong>
        of
        <strong>@(pagedDoctors?.TotalCount ?? 0)</strong>
        doctors
    </div>

    <div class="d-flex align-items-center gap-2">

        <button class="btn btn-outline-secondary btn-sm"
                disabled="@(pagedDoctors?.HasPrevious != true)"
                @onclick="PreviousPage">
            Previous
        </button>

        @if (pagedDoctors != null)
        {
            @for (int i = 1; i <= pagedDoctors.TotalPages; i++)
            {
                <button class="btn @(i == currentPage ? "btn-primary" : "btn-outline-primary") btn-sm"
                        @onclick="() => GoToPage(i)">
                    @i
                </button>
            }
        }

        <button class="btn btn-outline-secondary btn-sm"
                disabled="@(pagedDoctors?.HasNext != true)"
                @onclick="NextPage">
            Next
        </button>

    </div>

</div>
    }

</div>

@if (showForm)
{
    <div class="modal fade show d-block" style="background:rgba(14,58,92,.45);" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(isEditing ? "Edit doctor" : "Add doctor")</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="Cancel"></button>
                </div>

                <div class="modal-body">

                    @if (!string.IsNullOrEmpty(formError))
                    {
                        <div class="alert alert-danger">@formError</div>
                    }

                    @if (isEditing)
                    {
                        <EditForm Model="editDoctor" OnValidSubmit="HandleUpdate">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="row">

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Full name</label>
                                    <InputText class="form-control" @bind-Value="editDoctor.FullName" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Specialisation</label>
                                    <InputSelect class="form-select" @bind-Value="editDoctor.Specialisation">
                                        @foreach (var spec in Enum.GetValues<Specialisation>())
                                        {
                                            <option value="@spec">@spec</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Experience (years)</label>
                                    <InputNumber class="form-control" @bind-Value="editDoctor.YearsOfExperience" />
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Consultation fee</label>
                                    <InputNumber class="form-control" @bind-Value="editDoctor.ConsultationFee" />
                                </div>

                                <div class="col-md-4 mb-3 d-flex align-items-end">
                                    <div class="form-check form-switch mb-2">
                                        <InputCheckbox class="form-check-input" @bind-Value="editDoctor.IsActive" />
                                        <label class="form-check-label">Active</label>
                                    </div>
                                </div>

                            </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-cancel" @onclick="Cancel">Cancel</button>
                                <button type="submit" class="btn btn-save">Save changes</button>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <EditForm Model="newDoctor" OnValidSubmit="HandleCreate">
                            <DataAnnotationsValidator />
                            <ValidationSummary />

                            <div class="row">

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Full name</label>
                                    <InputText class="form-control" @bind-Value="newDoctor.FullName" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Specialisation</label>
                                    <InputSelect class="form-select" @bind-Value="newDoctor.Specialisation">
                                        @foreach (var spec in Enum.GetValues<Specialisation>())
                                        {
                                            <option value="@spec">@spec</option>
                                        }
                                    </InputSelect>
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Experience (years)</label>
                                    <InputNumber class="form-control" @bind-Value="newDoctor.YearsOfExperience" />
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Consultation fee</label>
                                    <InputNumber class="form-control" @bind-Value="newDoctor.ConsultationFee" />
                                </div>

                                <div class="col-md-4 mb-3">
                                    <label class="form-label">Email</label>
                                    <InputText class="form-control" @bind-Value="newDoctor.Email" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Password</label>
                                    <InputText type="password" class="form-control" @bind-Value="newDoctor.Password" />
                                </div>

                                <div class="col-md-6 mb-3">
                                    <label class="form-label">Confirm password</label>
                                    <InputText type="password" class="form-control" @bind-Value="newDoctor.ConfirmPassword" />
                                </div>

                            </div>

                            <div class="modal-footer">
                                <button type="button" class="btn btn-cancel" @onclick="Cancel">Cancel</button>
                                <button type="submit" class="btn btn-save">Create doctor</button>
                            </div>
                        </EditForm>
                    }

                </div>
            </div>
        </div>
    </div>
}

<style>

    :root {
        --hx-primary: #155E91;
        --hx-primary-dark: #0E3A5C;
        --hx-primary-light: #EAF2F8;
        --hx-bg: #FAFBFC;
        --hx-text: #1E293B;
        --hx-accent: #E2A33B;
        --hx-border: #E2E8F0;
        --hx-danger: #C0392B;
    }

    .page-header {
        background: white;
        padding: 24px 30px;
        border-radius: 16px;
        box-shadow: 0 6px 18px rgba(15, 76, 69, 0.06);
    }

    .header-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 12px;
        background: var(--hx-primary-light);
        color: var(--hx-primary);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .page-header h2 { color: var(--hx-text); }

    .search-wrap { position: relative; }

    .search-icon {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #adb5bd;
        pointer-events: none;
    }

    .search-wrap .form-control { padding-left: 36px; }

    .form-control:focus,
    .form-select:focus {
        border-color: var(--hx-primary);
        box-shadow: 0 0 0 3px rgba(15, 76, 69, 0.12);
    }

    .btn-add {
        background: var(--hx-primary);
        color: white;
        font-weight: 600;
        border: none;
        border-radius: 8px;
        padding: .55rem 1.1rem;
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        white-space: nowrap;
    }

    .btn-add:hover { background: var(--hx-primary-dark); color: white; }

    .table thead th {
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .06rem;
        color: #6c757d;
        padding: 16px;
        background: var(--hx-primary-light);
        border-bottom: none;
        font-weight: 700;
    }

    .table tbody td {
        padding: 16px;
        border-bottom-color: var(--hx-border);
    }

    .table tbody tr:hover { background: #FBFAF7; }

    .badge {
        padding: .45rem .8rem;
        font-size: .72rem;
        font-weight: 600;
        border-radius: 50rem;
        letter-spacing: .02rem;
    }

    .badge-spec {
        background: #EAF1F8;
        color: #2C5C8F;
    }

    .empty-icon { color: #ced4da; display: flex; justify-content: center; }

    /* Status toggle switch */
    .status-switch {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        cursor: pointer;
        user-select: none;
        font-size: 0.9rem;
    }

    .status-switch:focus-visible {
        outline: 2px solid var(--hx-primary);
        outline-offset: 3px;
        border-radius: 12px;
    }

    .switch-track {
        width: 38px;
        height: 21px;
        border-radius: 11px;
        background: #e3dfd6;
        position: relative;
        transition: background .15s ease;
        padding: 2px;
        box-sizing: border-box;
        flex-shrink: 0;
    }

    .switch-track.on { background: var(--hx-primary); }

    .switch-knob {
        width: 17px;
        height: 17px;
        background: #fff;
        border-radius: 50%;
        position: absolute;
        top: 2px;
        left: 2px;
        transition: left .15s ease;
        box-shadow: 0 1px 2px rgba(0,0,0,.25);
    }

    .switch-track.on .switch-knob { left: 19px; }

    .status-label { font-weight: 600; font-size: 0.82rem; }
    .text-active { color: var(--hx-primary); }
    .text-inactive { color: #a0a0a0; }

    .btn-edit {
        border: 1px solid var(--hx-primary);
        color: var(--hx-primary);
        background: transparent;
        font-weight: 600;
        font-size: .82rem;
        border-radius: 8px;
        padding: .35rem .9rem;
        transition: all .15s ease;
    }

    .btn-edit:hover { background: var(--hx-primary); color: white; }

    .modal-content {
        border-radius: 16px;
        border: none;
        overflow: hidden;
    }

    .modal-header {
        border-bottom: 1px solid var(--hx-border);
        background: var(--hx-primary-light);
    }

    .modal-title { color: var(--hx-text); font-weight: 700; }

    .modal-footer { border-top: 1px solid var(--hx-border); }

    .form-label {
        font-size: .85rem;
        font-weight: 600;
        color: var(--hx-text);
    }

    .btn-save {
        background: var(--hx-primary);
        border: none;
        color: white;
        font-weight: 600;
        border-radius: 8px;
        padding: .5rem 1.3rem;
    }

    .btn-save:hover { background: var(--hx-primary-dark); color: white; }

    .btn-cancel {
        background: transparent;
        border: 1px solid var(--hx-border);
        color: #6c757d;
        font-weight: 600;
        border-radius: 8px;
        padding: .5rem 1.3rem;
    }

    .validation-message { color: var(--hx-danger); font-size: .85rem; }

    .alert-danger {
        background: #FBEAE8;
        border: none;
        color: var(--hx-danger);
        border-radius: 10px;
    }

</style>

@code {

    private Specialisation? selectedSpecialisation;
    private string searchText = string.Empty;
    private PagedResult<DoctorDto>? pagedDoctors;
    private List<DoctorDto> doctors = [];

    private int currentPage = 1;
    private int pageSize = 5;
    private bool showForm;
    private bool isEditing;
    private string? formError;

    private CreateDoctorDto newDoctor = new();
    private UpdateDoctorDto editDoctor = new();
    private int editingDoctorId;

    protected override async Task OnInitializedAsync()
    {
        await RefreshDoctors();
    }

    private void ShowAddForm()
    {
        formError = null;
        isEditing = false;
        newDoctor = new CreateDoctorDto();
        showForm = true;
    }

    private void ShowEditForm(DoctorDto doctor)
    {
        formError = null;
        isEditing = true;
        editingDoctorId = doctor.DoctorId;
        editDoctor = new UpdateDoctorDto
        {
            FullName = doctor.FullName,
            Specialisation = doctor.Specialisation,
            YearsOfExperience = doctor.YearsOfExperience,
            ConsultationFee = doctor.ConsultationFee,
            IsActive = doctor.IsActive
        };
        showForm = true;
    }

    private void Cancel()
    {
        showForm = false;
        formError = null;
    }

    private async Task HandleCreate()
    {
        formError = null;
        try
        {
            var created = await DoctorService.CreateDoctor(newDoctor);
            if (created != null)
            {
                await RefreshDoctors();
                showForm = false;
            }
            else
            {
                formError = "Failed to create doctor.";
            }
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
    }

    private async Task HandleUpdate()
    {
        formError = null;
        try
        {
            var updated = await DoctorService.UpdateDoctor(editingDoctorId, editDoctor);
            if (updated != null)
            {
                await RefreshDoctors();
                showForm = false;
            }
            else
            {
                formError = "Failed to update doctor.";
            }
        }
        catch (Exception ex)
        {
            formError = ex.Message;
        }
    }

    private async Task ToggleActive(DoctorDto doctor)
    {
        var previous = doctor.IsActive;
        doctor.IsActive = !doctor.IsActive;

        var dto = new UpdateDoctorDto
        {
            FullName = doctor.FullName,
            Specialisation = doctor.Specialisation,
            YearsOfExperience = doctor.YearsOfExperience,
            ConsultationFee = doctor.ConsultationFee,
            IsActive = doctor.IsActive
        };

        try
        {
            var updated = await DoctorService.UpdateDoctor(doctor.DoctorId, dto);
            if (updated == null)
            {
                doctor.IsActive = previous;
            }
        }
        catch
        {
            doctor.IsActive = previous;
        }
    }

    private async Task RefreshDoctors()
    {
        pagedDoctors = await DoctorService.GetDoctors(
            currentPage,
            pageSize,
            selectedSpecialisation,
            searchText);

        doctors = pagedDoctors?.Items.ToList() ?? [];
    }

    private async Task FilterDoctors()
    {
        currentPage = 1;
        await RefreshDoctors();
    }

    private async Task SearchDoctors(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";

        currentPage = 1;

        await RefreshDoctors();
    }

    private async Task PreviousPage()
    {
        if (pagedDoctors?.HasPrevious == true)
        {
            currentPage--;
            await RefreshDoctors();
        }
    }

    private async Task NextPage()
    {
        if (pagedDoctors?.HasNext == true)
        {
            currentPage++;
            await RefreshDoctors();
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > (pagedDoctors?.TotalPages ?? 1))
            return;

        currentPage = page;
        await RefreshDoctors();
    }

}
