@page "/reports"
@attribute [Authorize]

@using HealthAxis.Admin.Services
@using HealthAxis.Shared.Common
@using HealthAxis.Shared.DTOs.AdminDtos

@inject AdminService AdminService
@inject NavigationManager NavigationManager

<PageTitle>Appointment Reports</PageTitle>

<div class="page-header mb-4">
    <div class="d-flex align-items-center gap-3">
        <div class="header-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                <path d="M14 2v6h6" />
                <path d="M9 13h6M9 17h6" />
            </svg>
        </div>
        <div>
            <h2 class="fw-bold mb-1">Appointment report</h2>
            <p class="text-muted mb-0">Daily breakdown of appointment status across the platform.</p>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4">

    @if (reports is null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status"></div>
            <div class="mt-3 text-muted">Loading report...</div>
        </div>
    }
    else if (!reports.Any())
    {
        <div class="text-center py-5">
            <div class="empty-icon mb-2">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <path d="M14 2v6h6" />
                    <path d="M9 13h6M9 17h6" />
                </svg>
            </div>
            <h5>No appointment data</h5>
            <p class="text-muted">Reports will appear here once appointments are recorded.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">

                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Pending</th>
                        <th>Confirmed</th>
                        <th>Cancelled</th>
                        <th>Completed</th>
                        <th>Total</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var report in reports)
                    {
                        <tr>

                            <td class="fw-semibold">@report.Date</td>

                            <td>
                                <span class="badge badge-pending">@report.PendingCount</span>
                            </td>

                            <td>
                                <span class="badge badge-confirmed">@report.ConfirmedCount</span>
                            </td>

                            <td>
                                <span class="badge badge-cancelled">@report.CancelledCount</span>
                            </td>

                            <td>
                                <span class="badge badge-completed">@report.CompletedCount</span>
                            </td>

                            <td>
                                <span class="total-value">@report.TotalAppointments</span>
                            </td>

                        </tr>
                    }
                </tbody>

            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center px-4 py-3 border-top">

    <div class="text-muted small">
        Showing
        <strong>@(reports.Count == 0 ? 0 : ((currentPage - 1) * pageSize) + 1)</strong>
        -
        <strong>@(((currentPage - 1) * pageSize) + reports.Count)</strong>
        of
        <strong>@(pagedReports?.TotalCount ?? 0)</strong>
        report entries
    </div>

    <div class="d-flex align-items-center gap-2">

        <button class="btn btn-outline-secondary btn-sm"
                disabled="@(pagedReports?.HasPrevious != true)"
                @onclick="PreviousPage">
            Previous
        </button>

        @if (pagedReports != null)
        {
            @for (int i = 1; i <= pagedReports.TotalPages; i++)
            {
                <button class="btn @(i == currentPage ? "btn-primary" : "btn-outline-primary") btn-sm"
                        @onclick="() => GoToPage(i)">
                    @i
                </button>
            }
        }

        <button class="btn btn-outline-secondary btn-sm"
                disabled="@(pagedReports?.HasNext != true)"
                @onclick="NextPage">
            Next
        </button>

    </div>

</div>
    }

</div>

<style>

    :root {
        --hx-primary: #155E91;
        --hx-primary-dark: #0E3A5C;
        --hx-primary-light: #EAF2F8;
        --hx-bg: #FAFBFC;
        --hx-text: #1E293B;
        --hx-accent: #E2A33B;
        --hx-border: #E2E8F0;
        --hx-danger: #C0392B;
    }

    .page-header {
        background: white;
        padding: 24px 30px;
        border-radius: 16px;
        box-shadow: 0 6px 18px rgba(21, 94, 145, 0.07);
    }

    .header-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 12px;
        background: var(--hx-primary-light);
        color: var(--hx-primary);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .page-header h2 { color: var(--hx-text); }

    .table thead th {
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .06rem;
        color: #6c757d;
        padding: 16px;
        background: var(--hx-primary-light);
        border-bottom: none;
        font-weight: 700;
    }

    .table tbody td {
        padding: 16px;
        border-bottom-color: var(--hx-border);
    }

    .table tbody tr:hover { background: #FBFAF7; }

    .badge {
        padding: .45rem .8rem;
        font-size: .8rem;
        font-weight: 700;
        border-radius: 50rem;
        min-width: 2.4rem;
        display: inline-block;
        text-align: center;
    }

    .badge-pending { background: #FBF1E1; color: var(--hx-accent); }
    .badge-confirmed { background: #EAF2F8; color: var(--hx-primary); }
    .badge-cancelled { background: #FBEAE8; color: var(--hx-danger); }
    .badge-completed { background: #E1F0EC; color: #1D7874; }

    .total-value {
        font-weight: 700;
        color: var(--hx-text);
        font-size: 1rem;
    }

    .empty-icon { color: #ced4da; display: flex; justify-content: center; }

</style>

@code {

    private PagedResult<AppointmentReportDto>? pagedReports;
    private List<AppointmentReportDto> reports = [];

    private int currentPage = 1;
    private int pageSize = 10;

    protected override async Task OnInitializedAsync()
    {
        await LoadReports();
    }

    private async Task LoadReports()
    {
        try
        {
            pagedReports = await AdminService.GetAppointmentReportAsync(
                currentPage,
                pageSize);

            reports = pagedReports?.Items.ToList() ?? [];
        }
        catch (System.Net.Http.HttpRequestException ex)
        {
            if (ex.Message.Contains("401") || ex.Message.Contains("Unauthorized"))
            {
                NavigationManager.NavigateTo("/login", true);
                return;
            }

            reports = [];
            pagedReports = null;
        }
    }

    private async Task PreviousPage()
    {
        if (pagedReports?.HasPrevious == true)
        {
            currentPage--;
            await LoadReports();
        }
    }

    private async Task NextPage()
    {
        if (pagedReports?.HasNext == true)
        {
            currentPage++;
            await LoadReports();
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > (pagedReports?.TotalPages ?? 1))
            return;

        currentPage = page;
        await LoadReports();
    }

}