@page "/auth"

@using HealthAxis.Admin.Authentication
@using HealthAxis.Admin.Configuration
@using Microsoft.AspNetCore.Components.Authorization

@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject AppSettings Settings

<h4>Signing in...</h4>

@code
{
    protected override async Task OnInitializedAsync()
    {
        var uri = new Uri(Navigation.Uri);

        string? token = null;

        if (!string.IsNullOrWhiteSpace(uri.Query))
        {
            var query = uri.Query.TrimStart('?').Split('&');

            foreach (var item in query)
            {
                var pair = item.Split('=');

                if (pair.Length == 2 && pair[0] == "token")
                {
                    token = Uri.UnescapeDataString(pair[1]);
                    break;
                }
            }
        }

        if (string.IsNullOrWhiteSpace(token))
        {
            Navigation.NavigateTo(Settings.AngularLoginUrl, true);
            return;
        }

        await JS.InvokeVoidAsync("localStorage.setItem", "token", token);

        if (AuthStateProvider is CustomAuthenticationStateProvider provider)
        {
            provider.NotifyUserLoggedIn(token);
        }

        Navigation.NavigateTo("/dashboard", true);
    }
}