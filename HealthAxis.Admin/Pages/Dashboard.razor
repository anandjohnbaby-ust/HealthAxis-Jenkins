@page "/dashboard"
@attribute [Authorize]

@using HealthAxis.Admin.Services
@using HealthAxis.Shared.DTOs.AdminDtos

@inject AdminService AdminService

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-header mb-4">
    <h2 class="fw-bold mb-1">Dashboard</h2>
    <p class="text-muted mb-0">
        Overview of users, doctors, patients and appointments.
    </p>
</div>

@if (dashboard is null)
{
    <div class="d-flex justify-content-center align-items-center" style="height:300px;">
        <div class="spinner-border text-primary" style="width:3rem;height:3rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}
else
{
    <div class="row g-4">

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card users">
                <div class="card-body">
                    <div class="card-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
                            <circle cx="9" cy="7" r="4" />
                            <path d="M23 21v-2a4 4 0 0 0-3-3.87" />
                            <path d="M16 3.13a4 4 0 0 1 0 7.75" />
                        </svg>
                    </div>
                    <div class="card-title">Total users</div>
                    <div class="card-value">@dashboard.TotalUsers</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card doctors">
                <div class="card-body">
                    <div class="card-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.29 1.51 4.04 3 5.5l7 7Z" />
                        </svg>
                    </div>
                    <div class="card-title">Total doctors</div>
                    <div class="card-value">@dashboard.TotalDoctors</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card patients">
                <div class="card-body">
                    <div class="card-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <path d="M4.8 2.3A.3.3 0 1 0 5 2H4a2 2 0 0 0-2 2v5a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6V4a2 2 0 0 0-2-2h-1a.2.2 0 1 0 .3.3" />
                            <path d="M8 15v1a6 6 0 0 0 6 6v0a6 6 0 0 0 6-6v-4" />
                            <circle cx="20" cy="10" r="2" />
                        </svg>
                    </div>
                    <div class="card-title">Total patients</div>
                    <div class="card-value">@dashboard.TotalPatients</div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="dashboard-card appointments">
                <div class="card-body">
                    <div class="card-icon">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
                            <rect x="3" y="4" width="18" height="18" rx="2" />
                            <path d="M16 2v4M8 2v4M3 10h18" />
                        </svg>
                    </div>
                    <div class="card-title">Appointments</div>
                    <div class="card-value">@dashboard.TotalAppointments</div>
                </div>
            </div>
        </div>

    </div>
}

@code
{
    private DashboardDto? dashboard;

    protected override async Task OnInitializedAsync()
    {
        dashboard = await AdminService.GetDashboardAsync();
    }
}